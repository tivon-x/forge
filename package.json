{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "A provider-neutral coding agent CLI",
  "type": "module",
  "bin": {
    "forge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "node dist/index.js",
    "smoke:openai": "pnpm build && node dist/index.js -p \"Read package.json, report the package name, and do not modify files.\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "openai": "6.46.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "26.1.1",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
